# Copy this file to .env and replace the placeholders. Never commit .env.
PRIMARY_MODEL=GOOGLE

GOOGLE_MODEL_PROVIDER=google_genai
GOOGLE_MODEL_NAME=gemini-3.5-flash-lite
GOOGLE_API_KEY=

OPENAI_MODEL_PROVIDER=openai
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=

ANTHROPIC_MODEL_PROVIDER=anthropic
ANTHROPIC_MODEL_NAME=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=

GROQ_MODEL_PROVIDER=groq
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_API_KEY=

# Replace both fields with your organization's real identifying contact.
SEC_USER_AGENT=Your Name your.email@company.com
